Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /stayin/

    # ------------------------------------------------------------------
    # Public assets
    # ------------------------------------------------------------------

    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    RewriteRule ^favicon\.png$ public/favicon.png [L]
    RewriteRule ^favicon\.ico$ public/favicon.ico [L]

    RewriteRule ^manifest\.webmanifest$ public/manifest.webmanifest [L]
    RewriteRule ^service-worker\.js$ public/service-worker.js [L]
    RewriteRule ^offline\.html$ public/offline.html [L]

    # ------------------------------------------------------------------
    # Never expose sensitive application directories/files
    # ------------------------------------------------------------------

    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|vendor|tests|cli|docs)(?:/|$) - [F,L,NC]

    RewriteRule ^(?:\.env|composer\.(?:json|lock)|phpunit\.xml|AGENTS\.md)$ - [F,L,NC]

    # ------------------------------------------------------------------
    # Existing root files/directories
    # ------------------------------------------------------------------

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ------------------------------------------------------------------
    # Application routes
    # ------------------------------------------------------------------

    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
