# ---------------------------------------------------------------------------
# StayIn application
# ---------------------------------------------------------------------------
APP_NAME="StayIn"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost/stayin/public
ASSET_URL=
CDN_URL=
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Dar_es_Salaam
APP_LOCALE=en
MAINTENANCE_MODE=false

# ---------------------------------------------------------------------------
# Database (MAMP defaults shown as placeholders only — verify your own values)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stayin_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
SESSION_NAME=stayin_session
SESSION_LIFETIME=120
SESSION_SECURE=false
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Booking engine
# ---------------------------------------------------------------------------
BOOKING_HOLD_MINUTES=15
BOOKING_MIN_NIGHTS=1
BOOKING_MAX_NIGHTS=60
BOOKING_REFERENCE_PREFIX=SI

# ---------------------------------------------------------------------------
# Currency
# ---------------------------------------------------------------------------
CURRENCY_BASE=TZS
CURRENCY_DEFAULT_DISPLAY=TZS
FX_PROVIDER=manual
FX_API_KEY=
FX_ENDPOINT=
FX_FALLBACK_USD_TZS=2643.562101
FX_FALLBACK_TZS_USD=0.000378

# ---------------------------------------------------------------------------
# Mail (MAIL_MAILER: log | smtp)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=hello@stayin.example
MAIL_FROM_NAME="StayIn"
MAIL_DEV_REDIRECT=

# ---------------------------------------------------------------------------
# Support / WhatsApp
# ---------------------------------------------------------------------------
SUPPORT_EMAIL=
SUPPORT_PHONE=
WHATSAPP_SUPPORT_NUMBER=
WHATSAPP_DEFAULT_MESSAGE="Hello StayIn, I would like help with my booking."

# ---------------------------------------------------------------------------
# Social login (leave blank to keep the feature disabled)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Payments (never enable live gateways without verified provider contracts)
# ---------------------------------------------------------------------------
PAYMENT_DEFAULT_GATEWAY=mock
PAYMENT_MOCK_ENABLED=true
PAYMENT_MPESA_ENABLED=false
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_ENDPOINT=
MPESA_WEBHOOK_SECRET=
PAYMENT_MIXX_ENABLED=false
MIXX_API_KEY=
MIXX_PUBLIC_KEY=
MIXX_SERVICE_PROVIDER_CODE=
MIXX_ENDPOINT=
MIXX_WEBHOOK_SECRET=
PAYMENT_AIRTEL_ENABLED=false
AIRTEL_API_KEY=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENDPOINT=
AIRTEL_WEBHOOK_SECRET=
PAYMENT_HALOPESA_ENABLED=false
HALOPESA_API_KEY=
HALOPESA_ENDPOINT=
HALOPESA_WEBHOOK_SECRET=
PAYMENT_CARD_ENABLED=false
CARD_PUBLIC_KEY=
CARD_SECRET_KEY=
CARD_ENDPOINT=
CARD_WEBHOOK_SECRET=
COMMISSION_DEFAULT_PERCENT=10.00

# ---------------------------------------------------------------------------
# Maps
# ---------------------------------------------------------------------------
MAP_PROVIDER=none
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
GA4_MEASUREMENT_ID=
ANALYTICS_FIRST_PARTY=true

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
FEATURE_SOCIAL_LOGIN_GOOGLE=false
FEATURE_SOCIAL_LOGIN_APPLE=false
FEATURE_LIVE_PAYMENTS=false
FEATURE_MOCK_PAYMENTS=true
FEATURE_HOST_SUBSCRIPTIONS=false
FEATURE_WHATSAPP_API=false
FEATURE_WHATSAPP_DEEPLINK=true
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_HOST_KYC=true
FEATURE_PROPERTY_VERIFICATION=true

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_CONNECT_SRC=
CSP_EXTRA_FRAME_SRC=
CSP_EXTRA_IMG_SRC=https:
FORCE_HTTPS=false
HSTS_ENABLED=false